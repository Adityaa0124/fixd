# Gemini (free tier works; every call is cached in engine/.cache)
GEMINI_API_KEY=
GEMINI_SOLVER_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.8-flash

FIXD_MAX_CALLS=250
FIXD_RPM=12
FIXD_OFFLINE=0

# Neon Postgres
DATABASE_URL=
DIRECT_URL=

PORT=4000
WEB_ORIGIN=http://localhost:5173
ADMIN_TOKEN=
RERUN_PER_HOUR=10

# Console
VITE_API_URL=http://localhost:4000
